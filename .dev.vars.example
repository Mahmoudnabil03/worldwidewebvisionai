# Copy to .dev.vars for local development (.dev.vars is gitignored).
# In production set these under
#   Workers & Pages -> visionguard -> Settings -> Variables and Secrets
# as ENCRYPTED secrets, not plaintext variables.

# ---------------------------------------------------------------------------
# REQUIRED. Signs session cookies and peppers password hashes.
# 32+ random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it signs everyone out AND invalidates every stored password hash,
# so existing users would have to reset. Set it once and leave it alone.
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# Raise on the Workers PAID plan; the 25,000 default exists to stay inside the
# Free plan's 10 ms CPU budget. Existing hashes keep working either way.
# PBKDF2_ITERATIONS="210000"

# ---------------------------------------------------------------------------
# Google sign-in — NOTHING TO SET HERE. Deliberately.
#
# There is no GOOGLE_CLIENT_SECRET in this project and there should never be
# one. "Sign in with Google" is wired up with the ID-token flow: the browser
# gets an assertion signed by Google, and functions/api/auth/google.js verifies
# that signature against Google's published public keys. A client secret is
# only needed for the authorization-code flow, which this does not use.
#
# The client ID is public — it ships in the page on every site that offers
# Google sign-in — and lives in public/google-auth.js so the browser and the
# server read the same value. The server compares it against each token's
# `aud` claim, which is what stops a token minted for someone else's app from
# working here. If you ever change the client ID, change it there, once.
#
# What DOES need doing, in the Google Cloud console for this client:
#   Authorised JavaScript origins -> https://visionguardeg.com
#                                    (and http://localhost:5173 for local dev)
# No redirect URI is required for this flow.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Administrators — OPTIONAL.
#
# An admin account is a staff account that can additionally read EVERY
# employee's attendance (the Team tab on /account, and /api/attendance/team).
# It grants nothing else.
#
# Two ways to be one: role='admin' on the users row, or the address listed
# here. The default, with this unset, is the single address
# admin@visionguardeg.com. Comma-separated for more than one.
#
# Addresses on this list CANNOT be registered through the public signup form —
# an admin account is created out of band:
#
#   bash/zsh:    SESSION_SECRET="secret" npm run admin:create -- --password "..."
#   PowerShell:  $env:SESSION_SECRET = "secret"
#                npm run admin:create -- --password "..."
#
# It must be the deployment's own SESSION_SECRET: passwords are peppered with
# it, so a hash built with a different one can never be signed into.
# ADMIN_EMAILS="admin@visionguardeg.com"

# ---------------------------------------------------------------------------
# Order notifications - ALL OPTIONAL.
#
# With none of this set, orders are still saved and the customer still gets a
# one-tap "send this order on WhatsApp" link on the confirmation screen. These
# variables only add the automatic push to your phone.
#
# Pick ONE provider. Telegram is the recommended one and wins automatically
# when TELEGRAM_BOT_TOKEN is set. See lib/whatsapp.js for the trade-offs.
# ---------------------------------------------------------------------------

# -- Option 0 (recommended): Telegram bot ------------------------------------
# Free, official, no template approval and no 24-hour sending window: the full
# multi-line Arabic summary arrives exactly as composed.
#
#   1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
#   2. Open your new bot and send it any message (a bot cannot message you
#      first). For a group, add the bot to the group instead.
#   3. Find the chat id:
#        curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      and read result[].message.chat.id — your own user id for a direct
#      message, or a negative id like -1001234567890 for a group.
#
# The token is a secret: anyone holding it controls the bot. Store it as an
# encrypted secret, never in wrangler.toml or a committed file, and /revoke it
# in @BotFather if it is ever pasted somewhere it should not have been.
# TELEGRAM_BOT_TOKEN=""        # e.g. 8961198092:AA...
# TELEGRAM_CHAT_ID=""          # e.g. 123456789 or -1001234567890
#
# Leaving TELEGRAM_CHAT_ID empty still works: the code falls back to reading
# the most recent chat from getUpdates. That only sees the last 24 hours and
# returns nothing once a webhook is set on the bot, so set it once you know it.

# --- WhatsApp options -------------------------------------------------------
# Where the WhatsApp notification goes (ignored by Telegram, which uses
# TELEGRAM_CHAT_ID). Defaults to the number published on the site.
WHATSAPP_TO="201105006854"

# -- Option 1: Meta WhatsApp Cloud API (official, free tier) -----------------
# WHATSAPP_TOKEN=""            # permanent access token from a System User
# WHATSAPP_PHONE_ID=""         # Phone number ID, NOT the phone number
# WHATSAPP_TEMPLATE=""         # approved template name with a single {{1}} body param
# WHATSAPP_TEMPLATE_LANG="ar"
# WHATSAPP_ALLOW_TEXT="1"      # send plain text instead of a template (only valid
#                              # inside a 24h window - see lib/whatsapp.js)

# -- Option 2: UltraMsg (unofficial bridge, no template approval) ------------
# ULTRAMSG_INSTANCE=""         # e.g. instance12345
# ULTRAMSG_TOKEN=""

# -- Option 3: Twilio WhatsApp ----------------------------------------------
# TWILIO_SID=""
# TWILIO_TOKEN=""
# TWILIO_FROM="14155238886"    # your Twilio WhatsApp sender, digits only

# -- Option 4: CallMeBot (free, one recipient, plain text) -------------------
# CALLMEBOT_KEY=""

# ---------------------------------------------------------------------------
# Meta Conversion API (server-side, no secret in source code)
# ---------------------------------------------------------------------------
# META_PIXEL_ID=""           # your Meta Pixel ID, e.g. 123456789012345
# META_DATASET_ID=""         # optional Meta dataset ID, e.g. 37444427775716864
# META_ACCESS_TOKEN=""       # secret access token for CAPI requests
# META_CURRENCY="EGP"        # optional currency code for purchase events
# META_TEST_EVENT_CODE=""    # optional debugging code from Events Manager
# META_ATTRIBUTION_SHARE="0.3"  # optional attribution share for the event

# Force a provider instead of auto-detecting from whichever keys are present.
# One of: telegram, meta, ultramsg, twilio, callmebot.
# NOTIFY_PROVIDER="telegram"
